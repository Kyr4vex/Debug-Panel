			<Item class="LocalScript" referent="RBX21495811B0B94AC6BF7F26E051AA230A">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--// Variables - services (entire code wrote on fast hand)
local CurrentState = true
local TweenService = game:GetService("TweenService")
local Time = 0.4
local CD = false
local OldSize = script.Parent.Main.Size

--// Main
script.Parent.ShowHide.MouseButton1Down:Connect(function()
	if not CD then
		script.Parent.Main.Visible = true
		CD = true
		CurrentState = not CurrentState
		if CurrentState then
			TweenService:Create(script.Parent.Main, TweenInfo.new(Time, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut), {Size = OldSize}):Play()
			TweenService:Create(script.Parent.ShowHide, TweenInfo.new(Time), {Rotation = 0}):Play()
		else
			TweenService:Create(script.Parent.Main, TweenInfo.new(Time, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut), {Size = UDim2.new(1,0,0,0)}):Play()
			TweenService:Create(script.Parent.ShowHide, TweenInfo.new(Time), {Rotation = 180}):Play()
		end
		task.wait(Time - Time / 10)
		if not CurrentState then
			script.Parent.Main.Visible = false
		end
		CD = false
	end
end)]]></ProtectedString>
