			<Item class="LocalScript" referent="RBXA254D91FCB944C46B5540A970892B45B">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--// Settings
local Colors = require(script.Parent.Settings)["Colors"]
local Settings = {
	["ColorEffect"] = true,
	["CETime"] = 1.2
}
local CurrentColor = 1
--// Services
local TweenService = game:GetService("TweenService")
--// Images
local ShowHideIMG = "rbxassetid://1248849587"

--// Fast Configure
if Settings["ColorEffect"] then
	script.Parent.BackgroundColor3 = Colors[CurrentColor]
	--// Create New Thread
	coroutine.wrap(function()
		while task.wait(Settings["CETime"]) do
			CurrentColor += 1
			TweenService:Create(script.Parent.Main.Buttons, TweenInfo.new(Settings["CETime"], Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {BackgroundColor3 = Colors[CurrentColor]:Lerp(Color3.new(0,0,0),0.25)}):Play()
			TweenService:Create(script.Parent, TweenInfo.new(Settings["CETime"], Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {BackgroundColor3 = Colors[CurrentColor]}):Play()
			if CurrentColor >= #Colors then
				CurrentColor = 0
			end
		end
	end)()
end]]></ProtectedString>
