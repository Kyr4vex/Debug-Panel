				<Properties>
					<ProtectedString name="Source"><![CDATA[-- note by kyr4vex: i made rewrote original script on REALLY FAST hand so its bad but work, ignore pls

--// Services
local UserInputService = game:GetService("UserInputService")

--// Instances
local gui = script.Parent

--// sum variables
local RobloxDrag = "rbxasset://textures/Cursors/DragDetector/ActivatedCursor.png"
local lastcursor

--// States
local dragging
local dragInput
local dragStart
local startPos

--// Functions
local function update(input)
	local delta = input.Position - dragStart
	gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

gui.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	if dragging then return end
	dragging = true
	activeInput = input
	lastCursor = UserInputService.MouseIcon
	UserInputService.MouseIcon = RobloxDrag
	dragStart = input.Position
	startPos = gui.Position
end)

UserInputService.InputEnded:Connect(function(input)
	if not dragging then return end
	local isMouseRelease =
		input.UserInputType == Enum.UserInputType.MouseButton1
	local isTouchRelease =
		input == activeInput
		and input.UserInputType == Enum.UserInputType.Touch
	if isMouseRelease or isTouchRelease then
		dragging = false
		activeInput = nil
		UserInputService.MouseIcon = lastCursor or ""
		lastCursor = nil
	end
end)

gui.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		update(input)
	end
end)]]></ProtectedString>
