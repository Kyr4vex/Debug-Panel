				<Item class="LocalScript" referent="RBX2351778DD8BC49C28B8A25F41FBF6B49">
					<Properties>
						<ProtectedString name="Source"><![CDATA[--// Imports
local Settings = require(script.Parent.Parent.Settings)

--// Background (don't touch)
script.Parent.Background.Visible = Settings["Main"]["Background"]["Visible"]; script.Parent.Background.Image = Settings["Main"]["Background"]["Image"]; script.Parent.Background.ImageTransparency = Settings["Main"]["Background"]["Transparency"]; script.Parent.Background.ImageContent = Content.fromUri(Settings["Main"]["Background"]["Image"])

--// Tabs (wrote on fast hand)
for _,b in pairs(script.Parent.Tabs:GetChildren()) do
	if b:IsA("Frame") then
		b.Visible = false
	end
end
script.Parent.Tabs.Game.Visible = true
for i,v in pairs(script.Parent.Buttons:GetChildren()) do
	if v:IsA("TextButton") then
		v.MouseButton1Down:Connect(function()
			for _,b in pairs(script.Parent.Tabs:GetChildren()) do
				if b:IsA("Frame") then
					b.Visible = false
					if b.Name == v.Name then
						b.Visible = true
					end
				end
			end
		end)
	end
end]]></ProtectedString>
