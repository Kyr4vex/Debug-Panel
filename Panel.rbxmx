							<Item class="LocalScript" referent="RBXA6AA05BEDF6947D5AA710613AD59C510">
								<Properties>
									<ProtectedString name="Source"><![CDATA[local players = game:GetService("Players")
local run_service = game:GetService("RunService")
local stats_service = game:GetService("Stats")
local workspace_service = game:GetService("Workspace")

local label = script.Parent
local elapsed = 0
local connection

local function get_ping()
	local success, value = pcall(function()
		return stats_service.Network.ServerStatsItem["Data Ping"]:GetValue()
	end)
	if success then
		return string.format("%.0f ms", value)
	end
	return "N/A"
end

local function get_job_id()
	if game.JobId == "" then
		return "N/A"
	end
	return string.sub(game.JobId, 1, 8)
end

connection = run_service.Heartbeat:Connect(function(delta_time)
	elapsed += delta_time
	if elapsed < 0.5 then
		return
	end
	elapsed = 0

	local camera = workspace_service.CurrentCamera
	local local_player = players.LocalPlayer

	local lines = {
		string.format("Game: %s", tostring(game.Name)),
		string.format("Players: %d / %d", #players:GetPlayers(), players.MaxPlayers),
		string.format("PlaceID: %s", tostring(game.PlaceId)),
		string.format("Job ID: %s", get_job_id()),
		string.format("Local Player: %s", local_player and local_player.Name or "N/A"),
		string.format("FPS: %.0f", 1 / math.max(delta_time, 0.000001)),
		string.format("Frame time: %.1f ms", delta_time * 1000),
		string.format("Ping: %s", get_ping()),
		string.format("Memory: %.0f MB", stats_service:GetTotalMemoryUsageMb()),
		string.format("Instances: %s", tostring(stats_service.InstanceCount)),
		string.format("Camera FOV: %s", camera and tostring(camera.FieldOfView) or "N/A"),
		string.format("Data in: %.2f KB/s", stats_service.DataReceiveKbps),
		string.format("Data out: %.2f KB/s", stats_service.DataSendKbps),
		string.format("Physics in: %.2f KB/s", stats_service.PhysicsReceiveKbps),
		string.format("Physics out: %.2f KB/s", stats_service.PhysicsSendKbps),
	}

	label.Text = table.concat(lines, "\n")
end)

label.Destroying:Connect(function()
	connection:Disconnect()
end)]]></ProtectedString>
