							<Item class="LocalScript" referent="RBX0F78C6858B64487AA0EF6A4AC27B86D2">
								<Properties>
									<ProtectedString name="Source"><![CDATA[local players = game:GetService("Players")
local run_service = game:GetService("RunService")
local user_input_service = game:GetService("UserInputService")
local workspace_service = game:GetService("Workspace")

local label = script.Parent
label.RichText = false

local local_player = players.LocalPlayer
local elapsed = 0
local last_position = user_input_service:GetMouseLocation()
local wheel_total = 0
local connection

local function format_vector(vector)
	return string.format("%.1f, %.1f, %.1f", vector.X, vector.Y, vector.Z)
end

local function get_ray_result(mouse_position)
	local camera = workspace_service.CurrentCamera
	if not camera then
		return nil
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	if local_player.Character then
		params.FilterDescendantsInstances = { local_player.Character }
	end

	local ray = camera:ViewportPointToRay(mouse_position.X, mouse_position.Y)
	return workspace_service:Raycast(ray.Origin, ray.Direction * 1000, params)
end

local function get_buttons()
	local left = user_input_service:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
	local right = user_input_service:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
	local middle = user_input_service:IsMouseButtonPressed(Enum.UserInputType.MouseButton3)
	return string.format("L:%s R:%s M:%s", left and "1" or "0", right and "1" or "0", middle and "1" or "0")
end

local wheel_connection = user_input_service.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		wheel_total += input.Position.Z
	end
end)

connection = run_service.Heartbeat:Connect(function(delta_time)
	elapsed += delta_time
	if elapsed < 0.1 then
		return
	end

	local mouse_position = user_input_service:GetMouseLocation()
	local movement = mouse_position - last_position
	local speed = movement.Magnitude / elapsed
	last_position = mouse_position
	elapsed = 0

	local camera = workspace_service.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.zero
	local result = get_ray_result(mouse_position)

	local hit_text = "N/A"
	local target_text = "N/A"
	local class_text = "N/A"
	local material_text = "N/A"
	local distance_text = "N/A"
	local normal_text = "N/A"

	if result then
		hit_text = format_vector(result.Position)
		target_text = result.Instance.Name
		class_text = result.Instance.ClassName
		material_text = result.Material.Name
		normal_text = format_vector(result.Normal)
		if camera then
			distance_text = string.format("%.1f studs", (result.Position - camera.CFrame.Position).Magnitude)
		end
	end

	local lines = {
		string.format("Screen: %d, %d", mouse_position.X, mouse_position.Y),
		string.format("Viewport: %d x %d", viewport.X, viewport.Y),
		string.format("Delta: %d, %d", movement.X, movement.Y),
		string.format("Speed: %.0f px/s", speed),
		string.format("Behavior: %s", user_input_service.MouseBehavior.Name),
		string.format("Icon visible: %s", tostring(user_input_service.MouseIconEnabled)),
		string.format("Buttons: %s", get_buttons()),
		string.format("Wheel total: %d", wheel_total),
		string.format("Last input: %s", user_input_service:GetLastInputType().Name),
		string.format("Hit: %s", hit_text),
		string.format("Target: %s", target_text),
		string.format("Class: %s", class_text),
		string.format("Material: %s", material_text),
		string.format("Distance: %s", distance_text),
		string.format("Normal: %s", normal_text),
	}

	label.Text = table.concat(lines, "\n")
end)

label.Destroying:Connect(function()
	connection:Disconnect()
	wheel_connection:Disconnect()
end)]]></ProtectedString>
